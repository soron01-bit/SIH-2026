# CYCLONEX Environment Variables Template

# Frontend Settings
VITE_API_URL=http://localhost:8000/api

# Backend Django Settings (Phase 2)
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-key
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Settings (Phase 2)
DB_NAME=cyclonex_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Inference Configuration (Phase 4/5)
MODEL_WEIGHTS_PATH=ml/models/cyclone_model.pth
DEVICE=cuda
MAX_UPLOAD_SIZE_MB=15
