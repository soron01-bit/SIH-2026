{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/voice/:path*",
      "destination": "/api/voice/:path*"
    },
    {
      "source": "/((?!api/|voice/).*)",
      "destination": "/index.html"
    }
  ]
}